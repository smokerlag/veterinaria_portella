{
  "name": "veterinaria-portella",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-sqlite ./node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3000",
    "build": "node --experimental-sqlite ./node_modules/next/dist/bin/next build",
    "start": "node --experimental-sqlite ./node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "db:seed": "node --experimental-sqlite --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
